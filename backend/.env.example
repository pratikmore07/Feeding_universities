PORT=5000
FRONTEND_URL=http://localhost:5173
# Set to the exact number of trusted reverse proxies in production (commonly 1).
TRUST_PROXY_HOPS=1

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
LEAD_EMAIL_TO=

GOOGLE_SHEET_ID=
# The existing COUNSELLING LEADS tab is used for counselling form submissions.
# Its first row is added automatically when the tab is empty.
GOOGLE_SHEET_RANGE=Leads!A:AJ
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Server-side conversion events. Configure both Meta values to enable CAPI.
# Use the same pixel ID as frontend VITE_META_PIXEL_ID for browser/server deduplication.
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=
GA4_DEBUG_MODE=false
META_PIXEL_ID=123456789012345
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
META_API_VERSION=v24.0
